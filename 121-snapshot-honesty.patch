diff --git a/css/style.css b/css/style.css
index 1d05e99..17b60b7 100644
--- a/css/style.css
+++ b/css/style.css
@@ -3499,3 +3499,55 @@ body.light #pwa-install-nudge-close { color: var(--ui-text-secondary); backgroun
 }
 .rb-action-btn:hover { color: #7dd3fc; }
 .rb-action-btn:disabled { opacity: 0.5; cursor: wait; }
+
+/* ===== 快照誠實化（行動 5）：官方快照 vs 推估資料的設計語言 ===== */
+/* 官方快照：冷色實心小標籤；推估：琥珀色虛線框。不貼工程術語。 */
+.snapshot-chip {
+  display: inline-block; font-size: 10px; font-weight: 800;
+  color: #a5f3fc; background: rgba(8,145,178,0.18);
+  border: 1px solid rgba(34,211,238,0.35);
+  padding: 1px 8px; border-radius: 999px; white-space: nowrap;
+}
+.snapshot-chip.is-proxy {
+  color: #fcd34d; background: rgba(245,158,11,0.10);
+  border: 1px dashed rgba(251,191,36,0.65);
+}
+.snapshot-chip.is-snapshot { color: #fdba74; background: rgba(249,115,22,0.12); border-color: rgba(249,115,22,0.4); }
+.snapshot-chip.is-stale { color: #fca5a5; background: rgba(239,68,68,0.10); border-color: rgba(248,113,113,0.5); }
+.snapshot-age { font-size: 10px; font-weight: 700; color: #94a3b8; white-space: nowrap; }
+.snapshot-age.is-stale { color: #fca5a5; }
+
+/* ===== 降級 UX：誠實的缺席（行動 7） ===== */
+.data-notice {
+  display: flex; align-items: flex-start; gap: 10px;
+  background: rgba(30,41,59,0.6); border: 1px solid rgba(251,191,36,0.25);
+  border-radius: 16px; padding: 12px 14px; text-align: left;
+}
+.data-notice-icon { color: #fbbf24; font-size: 16px; margin-top: 2px; flex-shrink: 0; }
+.data-notice-copy { flex: 1; min-width: 0; }
+.data-notice-title { font-size: 12px; font-weight: 900; color: #f1f5f9; }
+.data-notice-body { font-size: 11px; color: #94a3b8; margin-top: 3px; line-height: 1.6; }
+.data-notice-retry {
+  flex-shrink: 0; font-size: 11px; font-weight: 800; color: #38bdf8;
+  background: rgba(56,189,248,0.12); border: 1px solid rgba(56,189,248,0.4);
+  border-radius: 999px; padding: 5px 12px; cursor: pointer; align-self: center;
+}
+.data-notice-retry:hover { background: rgba(56,189,248,0.22); }
+
+/* ===== 30 秒總結條（行動 10） ===== */
+.ride-verdict-shell { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
+.ride-verdict-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; background: #64748b; }
+.ride-verdict-dot.is-go { background: #22c55e; box-shadow: 0 0 10px rgba(34,197,94,0.7); }
+.ride-verdict-dot.is-caution { background: #f59e0b; box-shadow: 0 0 10px rgba(245,158,11,0.7); }
+.ride-verdict-dot.is-stop { background: #ef4444; box-shadow: 0 0 10px rgba(239,68,68,0.8); animation: verdict-pulse 1.6s ease-in-out infinite; }
+.ride-verdict-dot.is-idle { background: #64748b; }
+@keyframes verdict-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.45; } }
+.ride-verdict-headline { font-size: 13px; font-weight: 900; color: #f1f5f9; line-height: 1.3; }
+.ride-verdict-sub { font-size: 10px; color: #94a3b8; margin-top: 2px; line-height: 1.5; }
+.ride-verdict-feedback {
+  flex-shrink: 0; font-size: 10px; font-weight: 800; color: #7dd3fc;
+  text-decoration: none; border: 1px solid rgba(125,211,252,0.35);
+  padding: 4px 10px; border-radius: 999px; white-space: nowrap;
+}
+.ride-verdict-feedback:hover { background: rgba(125,211,252,0.12); }
+.ride-verdict-feedback-block { display: inline-block; margin-top: 8px; }
