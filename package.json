{
  "name": "taiwan-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "sh scripts/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:desktop-layout": "playwright test tests/e2e/desktop-layout.spec.js --project=desktop-chromium",
    "test:e2e:desktop-refactor": "playwright test tests/e2e/desktop-layout.spec.js tests/e2e/desktop-camera-layer.spec.js tests/e2e/desktop-route-layer.spec.js tests/e2e/desktop-condition-layer.spec.js --project=desktop-chromium",
    "test:routes:live": "node scripts/audit-taiwan-routes.mjs",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.generated.css --minify",
    "start": "npm run build && python3 -m http.server 4173",
    "dev": "python3 -m http.server 4173",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:dev:fixture": "wrangler dev --config worker/wrangler.jsonc --var USE_FIXTURES:true",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:snapshot:build": "node scripts/build-provider-snapshot.mjs",
    "worker:snapshot:upload:staging": "wrangler kv bulk put /tmp/taiwan-dashboard-provider-snapshot.json --config worker/wrangler.jsonc --env staging --binding ROUTE_CACHE --remote"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tailwindcss/cli": "4.3.3",
    "maplibre-gl": "6.0.0",
    "tailwindcss": "4.3.3",
    "vitest": "^3.2.4",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
